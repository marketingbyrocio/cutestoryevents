vancedheading.kt-adv-heading1195_e7455a-d9[data-kb-block=\"kb-adv-heading1195_e7455a-d9\"]{font-style:normal;}.wp-block-kadence-advancedheading.kt-adv-heading1195_e7455a-d9 mark.kt-highlight, .wp-block-kadence-advancedheading.kt-adv-heading1195_e7455a-d9[data-kb-block=\"kb-adv-heading1195_e7455a-d9\"] mark.kt-highlight{font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}.wp-block-kadence-advancedheading.kt-adv-heading1195_e7455a-d9 img.kb-inline-image, .wp-block-kadence-advancedheading.kt-adv-heading1195_e7455a-d9[data-kb-block=\"kb-adv-heading1195_e7455a-d9\"] img.kb-inline-image{width:150px;vertical-align:baseline;}@media all and (max-width: 767px){.wp-block-kadence-advancedheading.kt-adv-heading1195_e7455a-d9, .wp-block-kadence-advancedheading.kt-adv-heading1195_e7455a-d9[data-kb-block=\"kb-adv-heading1195_e7455a-d9\"]{padding-bottom:0px;margin-bottom:0px;}}<\/style>\n<p class=\"kt-adv-heading1195_e7455a-d9 wp-block-kadence-advancedheading has-ast-global-color-3-color has-text-color\" data-kb-block=\"kb-adv-heading1195_e7455a-d9\">Ryan is an event lover through and through\u2014with a sharp eye for detail and a sense of humor that keeps things fun (even when things get a little wild). They got their start planning conferences and banquets in hotels and restaurants, hosting up to 200 guests in lively spaces.<br>\u200b<br>After catching the festival bug, Ryan jumped into the world of large-scale events like the Philadelphia Film Festival and SXSW\u2014where the chaos is half the fun! Most recently, they&#8217;ve been behind the scenes of virtual and hybrid events, helping bring together up to 400 people from all over.<br>\u200b<br>Cute Story Events was born from Ryan\u2019s passion for making every detail count and their love of meeting new people to create unforgettable, one-of-a-kind experiences.<\/p>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-container uagb-block-47a9744a\">\n<div class=\"wp-block-uagb-image uagb-block-ed2e1b8c wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" src=\"https:\/\/cutestoryevents.com\/wp-content\/uploads\/2026\/05\/inclusive-event-planner-cute-story-events-brand-portrait.avif\" alt=\"Inclusive event planner Ryan Criswell laughing in a colorful brand portrait for Cute Story Events\" class=\"uag-image-1197\" width=\"732\" height=\"734\" title=\"inclusive-event-planner-cute-story-events-brand-portrait\" loading=\"lazy\" role=\"img\" \/><\/figure><\/div>\n<\/div>\n<\/div>\n\n\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-uagb-container uagb-block-e86b85e6 alignfull uagb-is-root-container\"><div class=\"uagb-container-inner-blocks-wrap\">\n<div class=\"wp-block-uagb-container uagb-block-5b4e797c\">\n<div class=\"wp-block-uagb-info-box uagb-block-20fb9202 uagb-infobox__content-wrap  uagb-infobox-icon-above-title uagb-infobox-image-valign-top wp-block-uagb-info-box--has-margin\"><div class=\"uagb-infobox-margin-wrapper\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-title-wrap\"><h2 class=\"uagb-ifb-title\">THE CUTE WORKFLOW<\/h2><\/div><\/div><\/div><\/div>\n<\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-uagb-container uagb-block-96179937 alignfull uagb-is-root-container\"><div class=\"uagb-container-inner-blocks-wrap\">\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n<style>.wp-block-kadence-advancedheading.kt-adv-heading1195_102640-5c, .wp-block-kadence-advancedheading.kt-adv-heading1195_102640-5c[data-kb-block=\"kb-adv-heading1195_102640-5c\"]{font-size:var(--global-kb-font-size-md, 1.25rem);font-style:normal;}.wp-block-kadence-advancedheading.kt-adv-heading1195_102640-5c mark.kt-highlight, .wp-block-kadence-advancedheading.kt